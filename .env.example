# Human operator / console credential. Generate a unique high-entropy value.
UCOS_BROWSER_TOKEN=

# Separate credential for Model 1 agent tool routes. Never reuse UCOS_BROWSER_TOKEN.
# Keep empty until the agent integration is provisioned and the secret is set in Render.
UCOS_BROWSER_AGENT_TOKEN=

# Dedicated Neon PostgreSQL database for encrypted browser profile snapshots.
UCOS_BROWSER_STATE_DATABASE_URL=
# Fernet-compatible encryption key; generate independently and keep out of Model 1.
UCOS_BROWSER_STATE_ENCRYPTION_KEY=

PORT=10000
LOG_LEVEL=INFO
UCOS_BROWSER_PROFILE_DIR=/var/data/ucos-browser/profiles
UCOS_BROWSER_REQUIRE_DURABLE_PROFILE=true
UCOS_BROWSER_PERSISTENCE_CHECK_PROFILE=amazon-primary

# Fail closed. Do not set true without documented Amazon policy approval.
UCOS_AMAZON_AGENT_ACCESS_APPROVED=false
# Leave empty until an approved, accurate identifying User-Agent is established.
UCOS_AMAZON_AGENT_USER_AGENT=
